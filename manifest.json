{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.1",
  "description": "Блокирует комментарии, рекомендации и Shorts/Клипы на Rutube, YouTube и VK Видео для фокуса",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "*://rutube.ru/*",
    "*://vk.com/*",
    "*://m.vk.com/*",
    "*://vkvideo.ru/*",
    "*://www.vkvideo.ru/*",
    "*://www.youtube.com/*",
    "*://youtube.com/*",
    "*://m.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://rutube.ru/*",
        "*://vk.com/*",
        "*://m.vk.com/*",
        "*://vkvideo.ru/*",
        "*://www.vkvideo.ru/*",
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}